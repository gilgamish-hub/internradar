# Copy this file to .env and edit it. Every setting is optional: with no .env
# at all the portal still runs, scrapes and builds digests, and writes the
# emails it would have sent into data/outbox as .html files you can open.
#
# Lines starting with # are off. Uncomment the ones you want.

# --- email ----------------------------------------------------------------
# Leave these commented out and email stays off (digests go to data/outbox).
# For Gmail you need an *app password*, not your normal password:
#   1. Turn on 2-step verification on the Google account
#   2. Create one at https://myaccount.google.com/apppasswords
#   3. Uncomment the two lines below and paste it in, without spaces
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM_NAME=InternRadar

# Not on Gmail? Outlook / Office 365:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587

# --- web ------------------------------------------------------------------
# PORTAL_HOST=127.0.0.1      # 0.0.0.0 lets other devices on your wifi open it
# PORTAL_PORT=8700
# PORTAL_BASE_URL=http://127.0.0.1:8700   # the links inside the emails
# PORTAL_BRAND=InternRadar

# --- where to look --------------------------------------------------------
# naukri is an Indian board; outside India drop it and set the two lines below.
# SCAN_SITES=linkedin,naukri,indeed
# SCAN_COUNTRY=India
# SCAN_LOCATION=India

# --- how it scans ---------------------------------------------------------
# SCAN_RESULTS_PER_QUERY=20
# SCAN_DAYS=7                # how old a posting may be
# SCAN_FIELD_TTL_HOURS=8     # minimum gap between two scans of one field
# MIN_SCORE=35               # below this it is not called a match
# DEFAULT_MAX_ITEMS=10
# TZ_OFFSET_MINUTES=330      # fallback only; the browser reports the real one

# --- demo -----------------------------------------------------------------
# 1 loads 23 sample internships instead of scraping, so you can look around
# the portal straight away with no internet and no waiting.
# DEMO_MODE=0
